# Railway → Variables → RAW Editor. Use your own token and numeric operator IDs.
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_IDS=REPLACE_WITH_NUMERIC_TELEGRAM_IDS
BOT_TITLE=Эврикус
BOT_TIMEZONE=Asia/Amman
DATA_DIR=/app/data
RAILWAY_RUN_UID=0
